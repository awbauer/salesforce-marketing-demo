{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "{{WORKER_NAME}}",
  "main": "apps/edge/src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agent", "/agent/*", "/mcp/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MarketingOrchestrator",
        "class_name": "MarketingOrchestrator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MarketingOrchestrator"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "{{WORKER_NAME}}",
      "database_id": "{{D1_DATABASE_ID}}",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CAMPAIGN_ASSETS",
      "bucket_name": "{{WORKER_NAME}}-campaign-assets"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "AUTH_MODE": "access",
    "PROOF_WORKSPACE_ID": "{{INSTANCE_ID}}",
    "AI_GATEWAY_ID": "{{AI_GATEWAY_ID}}",
    "SALESFORCE_MCP_URL": "{{SALESFORCE_MCP_URL}}"
  },
  "triggers": { "crons": ["17 * * * *"] },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
