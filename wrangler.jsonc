{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "northstar-marketing-workbench-pot",
  "main": "apps/edge/src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agent", "/agent/*", "/mcp/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MarketingOrchestrator",
        "class_name": "MarketingOrchestrator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MarketingOrchestrator"]
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "northstar-marketing-workbench-pot",
      "database_id": "120cf689-0652-476c-9e4e-8af5b83e3627",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "CAMPAIGN_ASSETS",
      "bucket_name": "northstar-marketing-workbench-pot-campaign-assets"
    }
  ],
  "vars": {
    "ENVIRONMENT": "proof",
    "AUTH_MODE": "access",
    "PROOF_WORKSPACE_ID": "northstar-demo",
    "AI_GATEWAY_ID": "northstar-marketing-pot",
    "CAMPAIGN_IMAGE_MODEL": "@cf/black-forest-labs/flux-2-klein-4b",
    "SALESFORCE_MCP_URL": "https://northstar-mcp.becurious.one/mcp"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
