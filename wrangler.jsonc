{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "marketing-workbench-local",
  "main": "apps/edge/src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agent", "/agent/*", "/mcp/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "MarketingOrchestrator", "class_name": "MarketingOrchestrator" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MarketingOrchestrator"] }],
  "d1_databases": [
    {
      "binding": "APP_DB",
      "database_name": "marketing-workbench-local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "CAMPAIGN_ASSETS" }],
  "vars": {
    "ENVIRONMENT": "local",
    "AUTH_MODE": "development",
    "CHAT_ENGINE": "auto"
  }
}
