{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "includes": [
      "**",
      "!!node_modules",
      "!!dist",
      "!!**/.wrangler",
      "!!artifacts",
      "!!docs/archive",
      "!!wrangler.cloudflare.jsonc",
      "!!workbench.profile.json",
      "!!data/instance-dataset.json",
      "!!.workbench",
      "!!templates/aws/cdk/cdk.out",
      "!!templates/aws/cdk/node_modules",
      "!!playwright-report",
      "!!test-results",
      "!!apps/edge/src/worker-configuration.d.ts",
      "!!packages/contracts/src/generated",
      "!!apps/web/public/evals"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  }
}
