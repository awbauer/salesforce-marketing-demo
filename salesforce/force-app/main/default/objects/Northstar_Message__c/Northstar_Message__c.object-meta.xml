<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>An email, push, or SMS message saved from the Northstar workbench after human confirmation. Drafts only; nothing is sent.</description>
    <enableActivities>false</enableActivities>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <label>Northstar Message</label>
    <nameField>
        <label>Message Title</label>
        <type>Text</type>
    </nameField>
    <pluralLabel>Northstar Messages</pluralLabel>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
</CustomObject>
